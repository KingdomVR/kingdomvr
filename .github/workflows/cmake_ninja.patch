+	
+	def buildWithCMake(targets, clean)
+		config_name = getConfigName()
+		
+		if clean
+			Dir.chdir(@build_dir) do
+				exec_command("cmake --build . --target clean --config #{config_name}")
+			end
+		end
+		
+		Dir.chdir(@build_dir) do
+			target_args = targets.map { |t| "--target #{t}" }.join(" ")
+			exec_command("cmake --build . #{target_args} --config #{config_name} --parallel")
+		end
+	end
+	
+	
+	def installWithCMake()
+		Dir.chdir(@build_dir) do
+			exec_command("cmake --build . --target install --config #{getConfigName()}")
+		end
+	end
 	
